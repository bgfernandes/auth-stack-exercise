# ---------------------------------------------------------------------------------------------------------------
# INSECURE DEVELOPMENT DEFAULTS. Local use only.
#
# This file is committed on purpose so that `docker compose up` works on a clean clone with no setup step and no
# Node installed (docs/README.md §9, "Secrets"). Every value here is public knowledge and must never reach a
# network anyone else can see. A real deployment injects these from a secret store; see the root README trade-offs.
# ---------------------------------------------------------------------------------------------------------------

# --- Public hostname of Zitadel ------------------------------------------------------------------------------
# One hostname that the browser on the host and the app containers both use (docs/README.md §4.3, option (a)).
# localtest.me and its subdomains resolve to 127.0.0.1 in public DNS; inside compose, app services map it to the
# host gateway with extra_hosts. Zitadel refuses requests whose Host does not match these three settings.
ZITADEL_DOMAIN=auth.localtest.me
ZITADEL_EXTERNALPORT=8080
ZITADEL_EXTERNALSECURE=false

# --- Zitadel secrets and first instance ----------------------------------------------------------------------
# Encrypts secrets at rest inside Zitadel. Must be exactly 32 characters.
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
# Human admin of the first instance (IAM_OWNER). The login name is <username>@<org domain>; see docker/README.md.
ZITADEL_ADMIN_USERNAME=zitadel-admin
ZITADEL_ADMIN_PASSWORD=Password1!
# Expiry of the two personal access tokens Zitadel writes to the zitadel-bootstrap volume at first start:
# bootstrap.pat (the bootstrap machine user, IAM_OWNER) and login-client.pat (used by the Login V2 container).
PAT_EXPIRATION=2099-01-01T00:00:00Z
# Signs the Login V2 session cookie. At least 32 characters.
LOGIN_SESSION_COOKIE_SECRET=SessionCookieSecretNeedsAtLeast32Chars

# --- Postgres ------------------------------------------------------------------------------------------------
# Admin role of the Postgres container. docker/postgres/init.sql creates one database per service, each owned by
# a same-named role whose password is the role name: zitadel, spicedb, tenancy, documents.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
# Connection strings used inside compose (host "postgres"). Tilt-run processes use localhost:5432 instead.
ZITADEL_DATABASE_POSTGRES_DSN=postgresql://zitadel:zitadel@postgres:5432/zitadel?sslmode=disable
SPICEDB_DATASTORE_CONN_URI=postgres://spicedb:spicedb@postgres:5432/spicedb?sslmode=disable
TENANCY_DATABASE_URL=postgres://tenancy:tenancy@postgres:5432/tenancy
DOCUMENTS_DATABASE_URL=postgres://documents:documents@postgres:5432/documents

# --- Apps and seeds (read by the bootstrap container) --------------------------------------------------------
# Public URL of dashboard-web: what the browser uses, what is registered as its redirect URI, and what Zitadel
# calls for back-channel logout (zitadel-api maps the hostname to the host gateway, where port 3000 is published
# by compose or by the Tilt-run app alike).
DASHBOARD_WEB_URL=http://dashboard.localtest.me:3000
# Where the BFFs and dashboard-api reach tenancy-api inside compose (tickets 16 and 19a; Tilt overrides with
# localhost:4001).
TENANCY_API_URL=http://tenancy-api:4001
# Password of the seeded users alice, bob, and carol (@example.com); docs/README.md §6.3.
SEED_USER_PASSWORD=Password1!

# --- BFF sessions (packages/auth; read by every web app) ------------------------------------------------------
# Signs the login stash cookie (state, nonce, PKCE verifier between the redirect and the callback). At least 32
# characters; one value shared by the apps is fine in development, a real deployment gives each app its own.
SESSION_SECRET=dev-session-secret-needs-at-least-32-chars
# The session store inside compose (service "redis"); Tilt-run apps use localhost:6379 instead.
REDIS_URL=redis://redis:6379

# --- SpiceDB -------------------------------------------------------------------------------------------------
# Shared key every SpiceDB client presents as a bearer token; the APIs and bootstrap read it from their env.
SPICEDB_PRESHARED_KEY=dev-preshared-key
# Plaintext gRPC to SpiceDB (no TLS in the development stack); `packages/authz` defaults to TLS when unset.
SPICEDB_INSECURE=true

# --- Mail ----------------------------------------------------------------------------------------------------
# Sender of Zitadel's verification and reset emails; Mailpit catches everything at http://localhost:8025.
MAIL_FROM_ADDRESS=noreply@auth.localtest.me
MAIL_FROM_NAME=Auth Stack Exercise

# --- Pinned images -------------------------------------------------------------------------------------------
# Exact tags so every machine runs the same bits; bump them here deliberately.
ZITADEL_VERSION=v4.19.4
TRAEFIK_IMAGE=traefik:v3.7.14
POSTGRES_IMAGE=postgres:17.11-alpine
REDIS_IMAGE=redis:7.4.11-alpine
SPICEDB_IMAGE=authzed/spicedb:v1.56.2
ZED_IMAGE=authzed/zed:v1.2.1
MAILPIT_IMAGE=axllent/mailpit:v1.31.5
