{
  "name": "auth-stack-exercise",
  "version": "1.0.0",
  "description": "Reference IAM stack: OIDC login via Zitadel, fine-grained authorization with SpiceDB, Next.js + Fastify TypeScript monorepo.",
  "scripts": {
    "lint": "pnpm run lint:es && pnpm run lint:md",
    "lint:es": "eslint .",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm -r --include-workspace-root exec tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --passWithNoTests",
    "test:e2e": "pnpm run test:e2e:dashboard-web && pnpm run test:e2e:tenancy-web",
    "test:e2e:dashboard-web": "playwright test --config apps/dashboard-web/playwright.config.ts",
    "test:e2e:tenancy-web": "playwright test --config apps/tenancy-web/playwright.config.ts",
    "authz:zed": "docker compose run --rm zed",
    "authz:validate": "docker compose run --rm --no-deps zed validate --fail-on-warn /authz/schema.zed",
    "db:migrate": "pnpm -r --if-present run db:migrate"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@auth-stack/config": "workspace:*",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10",
    "typescript": "5.9.3"
  },
  "private": true,
  "packageManager": "pnpm@10.34.6"
}
